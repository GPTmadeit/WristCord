<?xml version="1.0" encoding="utf-8"?>
<!--
    How the phone finds this watch through CapabilityClient.

    Nothing in this app references this array - Play services reads it out of the APK by
    name. That makes it invisible to the resource shrinker, which is why shrinking is
    off, res/raw/keep.xml names it, and Capabilities.ensure() reads it through R.array
    and re-registers it at runtime. Three guards, because losing it breaks everything
    and breaks it silently.
-->
<resources>
    <string-array name="android_wear_capabilities">
        <item>wristcord_watch</item>
    </string-array>
</resources>
