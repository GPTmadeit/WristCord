<?xml version="1.0" encoding="utf-8"?>
<!--
    Four Google product colours as a broken ring around a mic. Sits inside the adaptive-icon
    safe zone (the central 72x72 of the 108x108 canvas).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ring: top blue, right red, bottom yellow, left green -->
    <path
        android:pathData="M37.29,34.08 A26,26 0 0 1 70.71,34.08"
        android:strokeColor="#4285F4"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M73.92,37.29 A26,26 0 0 1 73.92,70.71"
        android:strokeColor="#EA4335"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M70.71,73.92 A26,26 0 0 1 37.29,73.92"
        android:strokeColor="#FBBC04"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <path
        android:pathData="M34.08,70.71 A26,26 0 0 1 34.08,37.29"
        android:strokeColor="#34A853"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- mic capsule -->
    <path
        android:fillColor="#202124"
        android:pathData="M49,45 a5,5 0 0 1 10,0 v6 a5,5 0 0 1 -10,0 z" />
    <!-- cradle + stem -->
    <path
        android:pathData="M44,50 v1 a10,10 0 0 0 20,0 v-1"
        android:strokeColor="#202124"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,61 v6"
        android:strokeColor="#202124"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
</vector>
