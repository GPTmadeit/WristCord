    <path android:fillColor="#4285F4" android:pathData="M54,30h-8a16,16 0 0 0 -16,16v6h24z" />
    <path android:fillColor="#EA4335" android:pathData="M54,30h8a16,16 0 0 1 16,16v6h-24z" />
    <path android:fillColor="#34A853" android:pathData="M30,52h24v22h-8l-10,9v-9h-2a4,4 0 0 1 -4,-4z" />
    <path android:fillColor="#FBBC04" android:pathData="M78,52h-24v22h20a4,4 0 0 0 4,-4z" />
