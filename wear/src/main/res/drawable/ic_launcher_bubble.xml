    <path android:fillColor="#5865F2" android:pathData="M49,45 a5,5 0 0 1 10,0 v6 a5,5 0 0 1 -10,0 z" />
    <path android:pathData="M44,50 v1 a10,10 0 0 0 20,0 v-1" android:strokeColor="#5865F2" android:strokeWidth="3.4" android:strokeLineCap="round" />
