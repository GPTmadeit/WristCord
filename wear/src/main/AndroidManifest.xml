<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Always-on: the activity stays visible in the low-power ambient state. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Self-update straight from the project's GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Calls on the watch: the headset mic, routing audio to the headset, and the microphone
         foreground service (with its Ongoing Activity chip) that keeps a call up screen-off. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Sending a picture that is on the watch. Asked for only when the gallery is opened. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name="com.wristcord.wear.WristCordApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
            Standalone since 2.0: the watch signs in to Discord and talks to it directly. The
            phone app is optional and only needed to press mute/deafen/output on the phone's
            own Discord call.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name="com.wristcord.wear.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!--
            Switchable launcher icons. Android cannot change an icon at runtime, so each look
            is an activity-alias onto the same activity and exactly one is enabled at a time.
            Both modules declare the same four names, which is what lets the phone set the
            icon on both devices from one place.
        -->
        <activity-alias
            android:name=".LauncherHomage"
            android:targetActivity="com.wristcord.wear.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_homage"
            android:roundIcon="@mipmap/ic_launcher_homage"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPixel"
            android:targetActivity="com.wristcord.wear.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pixel"
            android:roundIcon="@mipmap/ic_launcher_pixel"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBubble"
            android:targetActivity="com.wristcord.wear.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bubble"
            android:roundIcon="@mipmap/ic_launcher_bubble"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherLink"
            android:targetActivity="com.wristcord.wear.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_link"
            android:roundIcon="@mipmap/ic_launcher_link"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <!-- LaunchAction fallback for tile taps on renderers without PendingIntent support. -->
        <activity
            android:name="com.wristcord.wear.tile.TileActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WristCord.Invisible" />

        <receiver
            android:name="com.wristcord.wear.tile.TileActionReceiver"
            android:exported="false" />

        <!-- Package installer's verdict on a self-update. -->
        <receiver
            android:name="com.wristcord.shared.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.wristcord.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.wristcord.wear.tile.WristCordTileService"
            android:description="@string/tile_description"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- A call on the watch: keeps it alive screen-off, and the watch-face chip. -->
        <service
            android:name="com.wristcord.wear.voice.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Watch-face complication: mute state at a glance, one tap to open the remote. -->
        <service
            android:name="com.wristcord.wear.tile.WristCordComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,MONOCHROMATIC_IMAGE" />
            <!-- 0 = never poll; we push updates when the phone sends new state. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

    </application>
</manifest>
