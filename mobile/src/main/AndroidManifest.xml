<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Best-effort screen wake before an accessibility click; see A11yStrategy.ensureScreenOn. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Reading available communication devices for the watch's output picker. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Product names of Bluetooth headsets in that list. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Self-update straight from the project's GitHub releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Optional status notification, and restoring it after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- We only ever look at one other package. -->
    <queries>
        <package android:name="com.discord" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WristCord">

        <activity
            android:name="com.wristcord.mobile.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <!--
            Switchable launcher icons. Android cannot change an icon at runtime, so each look
            is an activity-alias onto the same activity and exactly one is enabled at a time.
            Both modules declare the same four names, which is what lets the phone set the
            icon on both devices from one place.
        -->
        <activity-alias
            android:name=".LauncherHomage"
            android:targetActivity="com.wristcord.mobile.ui.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_homage"
            android:roundIcon="@mipmap/ic_launcher_homage"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPixel"
            android:targetActivity="com.wristcord.mobile.ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pixel"
            android:roundIcon="@mipmap/ic_launcher_pixel"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBubble"
            android:targetActivity="com.wristcord.mobile.ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bubble"
            android:roundIcon="@mipmap/ic_launcher_bubble"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherLink"
            android:targetActivity="com.wristcord.mobile.ui.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_link"
            android:roundIcon="@mipmap/ic_launcher_link"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <service
            android:name="com.wristcord.mobile.discord.DiscordNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name="com.wristcord.mobile.discord.DiscordAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/discord_accessibility_service" />
        </service>

        <!-- Optional: keeps a status notification up and the process warm. Off by default. -->
        <service
            android:name="com.wristcord.mobile.link.StatusService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name="com.wristcord.mobile.link.StatusActionReceiver"
            android:exported="false" />

        <receiver
            android:name="com.wristcord.mobile.link.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Package installer's verdict on a self-update. -->
        <receiver
            android:name="com.wristcord.shared.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.wristcord.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Started by Google Play services when the watch sends a command, even if nothing
             else of ours is running. This is what makes screen-off mute possible. -->
        <service
            android:name="com.wristcord.mobile.link.PhoneWearableListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/discord"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
